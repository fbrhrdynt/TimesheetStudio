[Unit]
Description=Timesheet Studio
After=network.target
[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/codex/timesheet-studio
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --env-file=/home/ubuntu/codex/timesheet-studio/.env /home/ubuntu/codex/timesheet-studio/server/node.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/codex/timesheet-studio-data
[Install]
WantedBy=multi-user.target
