# Copy to .env on the VPS. Never commit the real .env.
APP_URL=https://timesheet.example.com
HOST=127.0.0.1
PORT=3018
DATA_DIR=/home/ubuntu/codex/timesheet-studio-data
# Set only for the FIRST deployment. The first login requires a replacement.
# Remove this environment value after the admin has changed the password.
ADMIN_INITIAL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: base64 of exactly 32 random bytes. When empty, VPS creates DATA_DIR/encryption.key.
# Keep the original key for all future restarts and back it up separately. Never rotate by replacing it.
DATA_ENCRYPTION_KEY=
